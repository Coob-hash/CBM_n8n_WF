    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the quality-verification engine of a facility-maintenance system.\nImage 1 is the BEFORE photo of a reported issue: {{ $('Fetch Ticket').item.json.damage_description }} (object: {{ $('Fetch Ticket').item.json.object_type }}).\nImage 2 is the AFTER photo uploaded by the technician who claims the repair is complete.\n\nCompare the two images and respond with ONLY a minified JSON object, no markdown fences: {\"repair_verified\": true or false, \"confidence\": number between 0 and 1, \"observations\": one short factual sentence}.\nrepair_verified is true only if Image 2 plausibly shows the same object with the reported issue resolved.",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "before_photo"
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "data"
            }
          ]
        }
      },
      "id": "ad1c5b44-765d-4710-9912-ef673e93de76",
      "name": "Claude Vision - Verify Repair",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        600,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's before/after verdict and assemble the closure payload.\nconst raw = ($input.first().json.text || '').trim()\n  .replace(/^```(json)?/i, '').replace(/```$/, '').trim();\n\nlet v;\ntry {\n  v = JSON.parse(raw);\n} catch (e) {\n  v = { repair_verified: null, confidence: 0,\n        observations: 'Could not parse AI verdict. Raw output: ' + raw.slice(0, 200) };\n}\n\nconst ticket = $('Fetch Ticket').first().json;\nconst x = $('Extract Ticket ID').first().json;\nconst sql = (s) => String(s ?? '').replace(/'/g, \"''\");\n\nreturn [{\n  json: {\n    ...ticket,\n    after_file_id: x.file_id,\n    after_link: x.after_link,\n    repair_verified: v.repair_verified === true,\n    ai_confidence: v.confidence ?? 0,\n    observations: v.observations || '',\n    verification_sql: sql(JSON.stringify(v)),\n  },\n}];"
      },
      "id": "66ad97e7-7eb7-40db-975c-e23a953daa48",
      "name": "Parse Verification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        380
      ]
    },
