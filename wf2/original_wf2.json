      "parameters": {
        "jsCode": "// Link the uploaded AFTER photo to its ticket via the filename convention\n// TICKET-<id>.jpg (case-insensitive, tolerant to -, _ or space).\nconst f = $input.first().json;\nconst m = String(f.name || '').match(/TICKET[-_ ]?(\\d+)/i);\nreturn [{\n  json: {\n    matched: !!m,\n    ticket_id: m ? parseInt(m[1], 10) : null,\n    file_id: f.id,\n    file_name: f.name,\n    after_link: f.webViewLink || '',\n  },\n}];"
      },
      "id": "a1fbe4c3-09fb-4aa6-8493-20e5356a1511",
      "name": "Extract Ticket ID",
      "type": "n8n-nodes-base.code",
