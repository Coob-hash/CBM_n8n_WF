  "active": false,
  "nodes": [
    {
      "name": "Bound Context",
      "id": "1035f3346805fd25649930e5cf298bcd",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
