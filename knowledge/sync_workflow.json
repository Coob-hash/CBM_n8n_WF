          "conditions": [
            {
              "id": "fe8f5309e5bafd265aba09fd3e21f545",
              "leftValue": "={{ $json.build.documents.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
