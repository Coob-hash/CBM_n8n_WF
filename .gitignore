cbm/catalog/documents/*
cbm/validation/private-*
cbm/tests/all-workflows.json
cbm/case-study/upload-ready/

# Local run artifacts: validation snapshots, database dumps and checkpoints.
# Source SQL lives in database/; nothing else with a .sql extension is tracked.
validation/
validation-*/
validation-*.json
database-reset-backups/
wf2-checkpoints/
backups/
*.dump
*.sql
!database/**/*.sql

# Python environments, caches, and build artifacts
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# JavaScript dependencies and downloaded test runtime
node_modules/
.test-runtime/

# Generated BIM files, runtime data, and logs
/models/
/uploads/
/output/
/logs/
*.log
*.sqlite
*.sqlite3

# Local editors, operating-system files, and incidental backups
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.tmp
*.bak
*.bak-*
~$*

# n8n database export (contains credential and deployment-key entities)
cbm/tests/execution-audit/
