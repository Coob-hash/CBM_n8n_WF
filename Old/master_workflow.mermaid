%% CBM - Community-Based Maintenance: end-to-end master flow
%% Roles: human action / AI reasoning / system-deterministic / data store / human gate
flowchart TD

    subgraph P1["Phase 1 - Intake and Localization"]
        A1["Occupant photographs broken object"]:::human
        A2["Upload to Drive folder 01_incoming_snapshots"]:::human
        A3["Drive Trigger fires - New Ticket Opened"]:::sys
        A4["MultiSet - get M2M token"]:::sys
        A5["Download snapshot binary"]:::sys
        A6["MultiSet VPS query - image to 3D pose"]:::sys
        A7{"Pose found?"}:::gate
        A8["Normalize pose - use returned position"]:::sys
        A9["Fallback to mock pose - PoC keeps running"]:::sys
        A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7
        A7 -- yes --> A8
        A7 -- no --> A9
    end

    subgraph P2["Phase 2 - Triage, IFC Match and Dedup"]
        B1["Claude vision - classify object, damage, severity, trade"]:::ai
        B2["Parse triage - map object to IFC class hint"]:::sys
        B3["IFC service - nearest element to pose returns GlobalId"]:::sys
        B4{"Duplicate of an open ticket on same element?"}:::gate
        B5["Increment duplicate_count - community signal, no new ticket"]:::sys
        B6["Create ticket - status OPEN"]:::data
        B1 --> B2 --> B3 --> B4
        B4 -- yes --> B5
        B4 -- no --> B6
    end

    subgraph P3["Phase 3 - RAG Dispatch Cascade"]
        C1["Notify Facility Manager - new ticket"]:::sys
        C2["RAG vector search - candidate technicians"]:::sys
        C3["Compute SLA slot from severity - deterministic"]:::sys
        C4["Claude ranks up to 3 candidates"]:::ai
        C5{"Any candidate?"}:::gate
        C6["Loop - take next candidate - only ONE open offer at a time"]:::sys
        C7["Email offer - Accept or Decline, fixed slot, 12h timeout"]:::human
        C8{"Accepted?"}:::gate
        C9["Assign technician - status ASSIGNED"]:::data
        C10["Confirm to technician plus notify FM - nobody else invited"]:::sys
        C11["Log decline or timeout"]:::sys
        C12{"More candidates?"}:::gate
        C13["Status ESCALATED plus alert FM for manual assignment"]:::sys
        C2 --> C3 --> C4 --> C5
        C5 -- yes --> C6 --> C7 --> C8
        C8 -- yes --> C9 --> C10
        C8 -- no --> C11 --> C12
        C12 -- yes --> C6
        C12 -- no --> C13
        C5 -- no --> C13
    end

    subgraph P4["Phase 4 - Completion, Approval and IFC Update"]
        D1["Technician repairs and photographs the fixed object"]:::human
        D2["Upload TICKET-id.jpg to 02_completed_snapshots"]:::human
        D3["Drive Trigger fires on completion folder"]:::sys
        D4{"Filename maps to an open ticket?"}:::gate
        D5["Alert FM - unmatched photo"]:::sys
        D6["Download before and after photos, merge"]:::sys
        D7["Claude vision - verify repair, before vs after"]:::ai
        D8["Status PENDING_APPROVAL - AI verdict is a pre-screen only"]:::sys
        D9["FM approval - Approve or Reject, 72h"]:::gate
        D10{"Approved?"}:::gate
        D11["IFC service - write CBM_MaintenanceLog, save new version file"]:::sys
        D12["Close ticket - status CLOSED, store IFC version"]:::data
        D13["Notify technician and FM - closed"]:::sys
        D14["Status REWORK - technician re-uploads same filename"]:::sys
        D1 --> D2 --> D3 --> D4
        D4 -- no --> D5
        D4 -- yes --> D6 --> D7 --> D8 --> D9 --> D10
        D10 -- yes --> D11 --> D12 --> D13
        D10 -- no --> D14
    end

    A8 --> B1
    A9 --> B1
    B6 --> C1
    B6 --> C2
    C9 --> D1
    C10 --> D1
    D14 -.->|"re-trigger"| D3

    classDef human fill:#E8F0FE,stroke:#4285F4,stroke-width:2px,color:#111;
    classDef ai fill:#F3E8FD,stroke:#9334E6,stroke-width:2px,color:#111;
    classDef sys fill:#E6F4EA,stroke:#137333,stroke-width:2px,color:#111;
    classDef data fill:#FEF7E0,stroke:#F9AB00,stroke-width:2px,color:#111;
    classDef gate fill:#FCE8E6,stroke:#D93025,stroke-width:2px,color:#111;
