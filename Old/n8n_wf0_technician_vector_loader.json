    {
      "parameters": {
        "jsCode": "// Turn each technician row into a natural-language profile: this is the text\n// that gets embedded, so semantic queries like \"wooden door specialist\" can\n// match beyond exact trade tags.\nreturn $input.all().map(item => {\n  const t = item.json;\n  const trades = Array.isArray(t.trades) ? t.trades.join(', ') : String(t.trades || '');\n  return {\n    json: {\n      ...t,\n      trades_text: trades,\n      content:\n        `Technician ${t.name} (id ${t.id}). Trades and skills: ${trades}. ` +\n        `Zone: ${t.zone}. Rating: ${t.rating}/5. Jobs completed: ${t.jobs_completed}. ` +\n        `${t.active ? 'Currently active and available for dispatch.' : 'Currently INACTIVE - do not dispatch.'}`,\n    },\n  };\n});"
      },
      "id": "8c517103-ea82-4aa4-98dc-a193c8bb41ac",
      "name": "Build Profile Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        380
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "value": "technicians_documents",
          "mode": "list",
          "cachedResultName": "technicians_documents"
        },
        "options": {
          "queryName": "match_documents"
        }
      },
      "id": "eed4bdb6-534f-4be9-94e5-ded993f9dbf3",
      "name": "Insert into Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.1,
      "position": [
