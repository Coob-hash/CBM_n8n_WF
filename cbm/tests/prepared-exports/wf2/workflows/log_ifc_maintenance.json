{
  "name": "[CBM Intake Approval 2026.09.15] CBM - WF2 Guarded IFC Write",
  "nodes": [
    {
      "name": "Bound Context",
      "id": "1035f3346805fd25649930e5cf298bcd",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "context",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Parse Context",
      "id": "e084129603399b863ddb43785b86e1c7",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:JSON.parse($json.context)}];"
      }
    },
    {
      "name": "Read Approved Ticket",
      "id": "518296fd44a313a19a12f96077507112",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.*, $1::jsonb AS context FROM tickets t WHERE t.id=($1::jsonb->>'ticketId')::int\n AND t.status='PENDING_APPROVAL' AND t.approval_id=($1::jsonb->>'approvalId')::uuid\n AND EXISTS(SELECT 1 FROM ticket_events WHERE ticket_id=t.id AND event='CBM_WF2_APPROVAL'\n AND payload->>'approval_id'=t.approval_id::text AND payload->>'decision'='APPROVED');",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CREDENTIAL_ID",
          "name": "CBM Postgres"
        }
      }
    },
    {
      "name": "Element Available?",
      "id": "a342b0cb85c49874e11249845d11c0e4",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ !!$json.ifc_global_id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Write IFC",
      "id": "7f5be723fd8859416973cac3c4459d55",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Read Approved Ticket\").first().json.context.ifcServiceUrl.replace(/\\/+$/, \"\") + \"/elements/\" + $(\"Read Approved Ticket\").first().json.ifc_global_id + \"/maintenance\" }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ticket_id:$(\"Read Approved Ticket\").first().json.id,operation_key:$(\"Read Approved Ticket\").first().json.context.operationKey,technician:$(\"Read Approved Ticket\").first().json.context.technicianName,description:$(\"Read Approved Ticket\").first().json.description,condition:\"Repaired\",approved_by:\"Facility Manager\"}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "name": "Skip Missing Element",
      "id": "ce6ee7dbd2224308f25d57883701278a",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "jsCode": "return [{json:{skipped:true,detail:\"No IFC GlobalId; maintenance synchronization skipped\"}}];"
      }
    },
    {
      "name": "Normalize IFC Result",
      "id": "cac4d2bbb29e09025c009df0932e7ab7",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const x=$json,c=$('Read Approved Ticket').first().json.context;\nconst version=typeof x.version_file==='string'&&/^[A-Za-z0-9_. -]+\\.ifc$/i.test(x.version_file)?x.version_file:null;\nreturn [{json:{...c,version,status:version?'SUCCEEDED':x.skipped?'SKIPPED':'FAILED',detail:version?'IFC write persisted':String(x.detail||x.error?.message||x.error||'IFC result missing')}}];"
      }
    },
    {
      "name": "Persist IFC Result",
      "id": "b04573d3dc2870aacb53a9664157b466",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE tickets SET ifc_new_version=coalesce($3,ifc_new_version)\n WHERE id=$1 AND approval_id=$2::uuid AND status='PENDING_APPROVAL' RETURNING id),\n audit AS (INSERT INTO ticket_events(ticket_id,event,payload) SELECT id,\n CASE WHEN $4='FAILED' THEN 'CBM_WF2_ATTEMPT' ELSE 'CBM_WF2_IFC_RESULT' END,\n jsonb_build_object('operation_key',$5::text,'operation','log_ifc_maintenance','outcome',$4::text,'detail',$6::text,'version_file',$3::text)\n FROM updated RETURNING id) SELECT $4::text AS status,$3::text AS version_file;",
        "options": {
          "queryReplacement": "={{ [$json.ticketId,$json.approvalId,$json.version,$json.status,$json.operationKey,$json.detail] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CREDENTIAL_ID",
          "name": "CBM Postgres"
        }
      }
    }
  ],
