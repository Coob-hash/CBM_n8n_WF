      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_KNOWLEDGE_HEADER_CREDENTIAL_ID",
          "name": "CBM Knowledge Source Header"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.cbm_begin_knowledge($1::jsonb) AS build;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}",
          "queryBatching": "single"
        }
      },
      "id": "775a980c1045827ac4a7018a0a93dc42",
      "name": "Begin Knowledge Generation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "CBM Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "bdcb8046e1ea84f4b571724bb57c7ba9",
              "leftValue": "={{ $json.build.action === \"BUILD\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c9a83114f5728e98982e3503cb3fb05f",
      "name": "Build Required?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "fe8f5309e5bafd265aba09fd3e21f545",
              "leftValue": "={{ $json.build.documents.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d15d16808a3e29ae0d9ecf3842e9750a",
      "name": "Embedding Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $json.build.documents.map(json=>({json}));"
