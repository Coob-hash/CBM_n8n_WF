# Merge into an existing TLS-enabled n8n server block after substituting values.
# Do not apply this allow-list to the public technician offer response endpoint.
location ~ ^/webhook/(REPLACE_FM_CHAT_WEBHOOK_ID|cbm-wf1-resume)(/|$) {
    allow REPLACE_FM_IP_OR_CIDR;
    deny all;
    proxy_pass http://127.0.0.1:5678;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
# Alternatively protect only these FM routes with your organization's SSO.
