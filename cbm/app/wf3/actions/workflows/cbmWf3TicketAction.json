      "name": "Reuse Rework Transition",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH v AS (SELECT $1::jsonb AS p) UPDATE tickets SET status='REWORK',closed_at=NULL,fm_reject_reason=v.p->>'rejectionReason',updated_at=clock_timestamp() FROM v WHERE tickets.id=(v.p->>'ticketId')::int AND tickets.status='PENDING_APPROVAL' AND tickets.approval_id=(v.p->>'approvalId')::uuid AND EXISTS(SELECT 1 FROM ticket_events e WHERE e.ticket_id=tickets.id AND e.event='CBM_WF2_APPROVAL' AND e.payload->>'approval_id'=v.p->>'approvalId' AND e.payload->>'decision'='REJECTED') RETURNING tickets.id,tickets.status;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($('Stored Action Context').first().json.context)] }}"
        }
