      "id": "836522a3-681f-5638-ada3-adbf8f7cacb6",
      "name": "Reuse Technician Statistics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH receipt AS (\n INSERT INTO ticket_events(ticket_id,event,payload) SELECT id,'CBM_WF2_STATS',jsonb_build_object('approval_id',approval_id)\n FROM tickets WHERE id=($1::jsonb->>'ticketId')::int AND status='CLOSED' AND approval_id=($1::jsonb->>'approvalId')::uuid\n ON CONFLICT DO NOTHING RETURNING ticket_id)\n UPDATE technicians SET jobs_completed=jobs_completed+1 WHERE id IN (SELECT technician_id FROM tickets WHERE id IN (SELECT ticket_id FROM receipt)) RETURNING id,jobs_completed;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($('Stored Action Context').first().json.context)] }}"
        }
