    },
    {
      "parameters": {},
      "name": "Notice Result",
      "id": "cbm-wf2-notice-result",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1584,
        272
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE WHEN $1::integer IS NOT NULL THEN cbm_issue_technician_report_link($1::integer) ELSE NULL END AS report_link;",
        "options": {
          "queryReplacement": "={{ [$(\"Claim Closure Notice\").first().json.notice_key === \"technician:rework\" ? $(\"Claim Closure Notice\").first().json.ticket_id : null] }}"
        }
      },
      "id": "a12731c980400b9e20aca83ce145fb21",
      "name": "Prepare Technician Report Link",
      "type": "n8n-nodes-base.postgres",
      "position": [
        704,
        384
      ],
      "typeVersion": 2.6,
      "credentials": {
        "postgres": {
          "id": "cbmLocalPg20260917",
          "name": "CBM Postgres - Local Demo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const d=$('Claim Closure Notice').first().json,link=$json.report_link;\n if(d.notice_key==='technician:rework'&&!link?.token)throw new Error('Cannot issue a revised report link');\n return [{json:{...d,report_url:link?.token?\"https://bonanza-progress-hangover.ngrok-free.dev/webhook/cbm-technician-report\"+'?ticketId='+link.ticketId+'&token='+encodeURIComponent(link.token):null}}];"
      },
      "id": "9261fa85b27f654e8231246e791c0329",
      "name": "Attach Technician Report Link",
      "type": "n8n-nodes-base.code",
      "position": [
