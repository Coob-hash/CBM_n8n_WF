    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.* FROM jsonb_to_record(cbm_wf2_claim_notice($1::jsonb)) AS r\n (send_status text,ticket_id int,approval_id uuid,notice_key text,claim_id uuid,recipient text,ifc_new_version text,reason text,already_sent boolean);",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
      "name": "Claim Closure Notice",
      "id": "2115ca56-cd49-45fe-9690-d837111c8f7c",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        432,
        96
      ],
      "credentials": {
        "postgres": {
          "id": "cbmLocalPg20260917",
          "name": "CBM Postgres - Local Demo"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.send_status === \"SEND\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Send Required?",
      "id": "cbm-wf2-send-required",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        96
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.recipient }}",
        "subject": "={{ \"[CBM] Ticket #\"+$json.ticket_id+($json.notice_key === \"technician:rework\" ? \" - rework required\" : \" - closed, IFC updated\") }}",
        "emailType": "text",
        "message": "={{ $json.notice_key === \"technician:rework\" ? \"Ticket #\"+$json.ticket_id+\": \"+$json.reason+\" Complete a revised report after the required work: \"+$json.report_url : \"Ticket #\"+$json.ticket_id+\" is closed following FM approval. IFC version: \"+$json.ifc_new_version }}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Send Closure Notice",
      "id": "6e78d277-9dc8-4591-9da8-55a19c62eacc",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        896,
        0
      ],
      "retryOnFail": false,
      "webhookId": "2b357197-a954-430c-8256-998afd724696",
      "alwaysOutputData": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "R5EQDxDzCMYdMH9U",
          "name": "Gmail account 3"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Gmail output is the only source of a send receipt; the agent supplies none.\nconst claim = $('Claim Closure Notice').first().json;\nconst response = $input.first().json;\nconst sent = !response.error && typeof response.id === 'string' && response.id.trim().length > 0;\nreturn [{json:{ticket_id:claim.ticket_id,approval_id:claim.approval_id,\n  notice_key:claim.notice_key,claim_id:claim.claim_id,\n  send_status:sent?'SENT':'UNCONFIRMED',message_id:sent?response.id:null,\n  error:sent?null:String(response.error?.message||response.error||'Gmail returned no message ID; inspect the execution before retrying').slice(0,1000)}}];\n"
      },
      "name": "Validate Gmail Receipt",
      "id": "cbm-wf2-gmail-receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cbm_wf2_record_notice($1::jsonb) AS result;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
      "name": "Record Notice Result",
      "id": "39ca7df8-b263-4524-9b3d-d4cfea883979",
      "type": "n8n-nodes-base.postgres",
