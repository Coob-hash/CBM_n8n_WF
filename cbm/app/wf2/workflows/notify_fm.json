        384
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "content": "#  WF2 Notify FM from Stored Result\n\n## Purpose: Send FM or technician closure/rework notifications.\n\nNodes and logic:\n1. Bound Context → Parse Context — receive ticket, approval and recipient role.\n2. Claim Closure Notice → Send Required? — verify the ticket state and prevent duplicate sending.\n3. Send Closure Notice → Validate Gmail Receipt — send and check Gmail’s response.\n4. Record Notice Result → Notice Result — persist and return the outcome.\n\nIf sending is unnecessary or blocked, the workflow goes directly to Notice Result.\n\n## Result: A recorded notification outcome for the Closure Supervisor.",
        "height": 976,
        "width": 1920,
        "color": 7
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -160,
        -336
      ],
      "typeVersion": 1,
      "id": "f2f7c09f-2580-4318-b094-380e37175a80",
      "name": "Sticky Note"
    }
