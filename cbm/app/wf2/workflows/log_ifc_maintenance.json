{
  "id": "eqrcZZLPvsjRgCUR",
  "name": "[CBM Intake Approval 2026.09.15] CBM - WF2 Guarded IFC Write",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "context"
            }
          ]
        }
      },
      "name": "Bound Context",
      "id": "1a794d56-6458-4b0e-a49e-1ea90a52f76e",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -880,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:JSON.parse($json.context)}];"
      },
      "name": "Parse Context",
      "id": "fbfefbf1-1187-4a9d-965f-7ae52749ab9a",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.*, $1::jsonb AS context,cbm_wf2_ifc_succeeded(t.id,t.approval_id) AS ifc_recorded\n FROM tickets t WHERE t.id=($1::jsonb->>'ticketId')::int AND t.status IN ('PENDING_APPROVAL','CLOSED')\n AND t.approval_id=($1::jsonb->>'approvalId')::uuid\n AND EXISTS(SELECT 1 FROM ticket_events WHERE ticket_id=t.id AND event='CBM_WF2_APPROVAL'\n AND payload->>'approval_id'=t.approval_id::text AND payload->>'decision'='APPROVED');",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
      "name": "Read Approved Ticket",
      "id": "a0fdcab1-0f83-468c-a40a-59d94e55be85",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "cbmLocalPg20260917",
          "name": "CBM Postgres - Local Demo"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ !!$json.ifc_global_id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Element Available?",
      "id": "f78ca48d-2362-45ab-b278-fdd44e157768",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Read Approved Ticket\").first().json.context.ifcServiceUrl.replace(/\\/+$/, \"\") + \"/elements/\" + $(\"Read Approved Ticket\").first().json.ifc_global_id + \"/maintenance\" }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ticket_id:$(\"Read Approved Ticket\").first().json.id,operation_key:$(\"Read Approved Ticket\").first().json.context.operationKey,technician:$(\"Read Approved Ticket\").first().json.context.technicianName,description:$(\"Read Approved Ticket\").first().json.description,condition:\"Repaired\",approved_by:\"Facility Manager\"}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Write IFC",
      "id": "c143012e-b3e4-42bb-aa6d-b1467d915a72",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{json:{skipped:true,detail:\"Missing IFC GlobalId: update and ticket closure are blocked\"}}];"
      },
      "name": "Skip Missing Element",
      "id": "3a42faf6-47a3-4db7-95c7-88176c6b8105",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json,t=$('Read Approved Ticket').first().json,c=t.context;\n const version=!x.error&&x.global_id===t.ifc_global_id&&typeof x.version_file==='string'&&/^[A-Za-z0-9_. -]+\\.ifc$/i.test(x.version_file)?x.version_file:null;\n return [{json:{...c,version,status:version?'SUCCEEDED':'FAILED',detail:version?'IFC write persisted':String(x.detail||x.error?.message||x.error||'Missing or mismatched IFC result')}}];"
      },
      "name": "Normalize IFC Result",
      "id": "9514d135-93da-44b7-a56b-1f68f841a73a",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\n UPDATE tickets SET ifc_new_version=CASE WHEN $4='SUCCEEDED' THEN $3 ELSE ifc_new_version END\n WHERE id=$1 AND approval_id=$2::uuid AND status='PENDING_APPROVAL'\n AND $5='wf2:'||id||':'||approval_id\n AND EXISTS(SELECT 1 FROM ticket_events e WHERE e.ticket_id=tickets.id AND e.event='CBM_WF2_APPROVAL'\n AND e.payload->>'approval_id'=$2::text AND e.payload->>'decision'='APPROVED') RETURNING id),\n audit AS (INSERT INTO ticket_events(ticket_id,event,payload) SELECT id,\n CASE WHEN $4='SUCCEEDED' THEN 'CBM_WF2_IFC_RESULT' ELSE 'CBM_WF2_ATTEMPT' END,\n jsonb_build_object('approval_id',$2::text,'operation_key',$5::text,'operation','log_ifc_maintenance','outcome',$4::text,'detail',$6::text,'version_file',$3::text)\n FROM updated RETURNING id)\n SELECT CASE WHEN EXISTS(SELECT 1 FROM audit) THEN $4::text ELSE 'BLOCKED' END AS status,\n CASE WHEN EXISTS(SELECT 1 FROM audit) AND $4='SUCCEEDED' THEN $3::text END AS version_file;",
        "options": {
          "queryReplacement": "={{ [$json.ticketId,$json.approvalId,$json.version,$json.status,$json.operationKey,$json.detail] }}"
        }
      },
      "name": "Persist IFC Result",
      "id": "1cb7c49f-65c0-4b6f-997d-380aa56d7d49",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "cbmLocalPg20260917",
          "name": "CBM Postgres - Local Demo"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ifc_recorded === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IFC Already Recorded?",
      "id": "cbm-wf2-ifc-already-recorded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -288,
        -112
      ]
    },
    {
      "name": "Return Recorded IFC Result",
